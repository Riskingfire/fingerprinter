{
  "version": "V0.4",
  "features": [
    {
      "id": "ui",
      "name": "User Interface",
      "description": "The complete Fingerprinter UI and all basic ui_*.py modules.",
      "default": true,
      "includes": [
        "ui_class",
        "ui_compare",
        "ui_detect",
        "ui_keys",
        "ui_resources",
        "ui_screen",
        "ui_tk"
      ]
    },
    {
      "id": "advanced_ui",
      "name": "Advanced UI",
      "description": "Advanced interface features including history, library, modules, notes, and zoom tools.",
      "default": true,
      "includes": [
        "ui_history",
        "ui_library",
        "ui_modules",
        "ui_notes",
        "ui_zoom"
      ]
    },
    {
      "id": "export_and_session",
      "name": "Export Tools & Session Log",
      "description": "Export utilities and session logging tools with their UI interfaces.",
      "default": false,
      "includes": [
        "export_tools",
        "session_log",
        "ui_export"
      ]
    },
    {
      "id": "integrations",
      "name": "Integrations",
      "description": "Integration backend",
      "default": false,
      "includes": [
        "integrations",
        "ui_integrations"
      ]
    },
    {
      "id": "server",
      "name": "Server",
      "description": "Server synchronization",
      "default": false,
      "includes": [
        "server_sync",
        "ui_server"
      ]
    },
    {
      "id": "calibration",
      "name": "Clarity Calibration",
      "description": "Population-relative similarity scoring with a Recalibrate button, so keybind-driven similarity does not make every account look the same.",
      "default": false,
      "includes": [
        "similarity_calibration",
        "ui_calibration"
      ]
    },
    {
      "id": "base_only",
      "name": "No optional modules (game and server bases)",
      "description": "Install just the chosen base. Use this for the game and server bases, which do not use modules.",
      "default": false,
      "includes": []
    }
  ],
  "modules": [
    {
      "id": "export_tools",
      "name": "Export Tools Backend",
      "file": "export_tools.py",
      "type": "python"
    },
    {
      "id": "session_log",
      "name": "Session Log",
      "file": "session_log.py",
      "type": "python"
    },
    {
      "id": "ui_export",
      "name": "UI Export Interface",
      "file": "ui_export.py",
      "type": "python",
      "requires": [
        "export_tools",
        "ui_tk"
      ]
    },
    {
      "id": "ui_history",
      "name": "UI History",
      "file": "ui_history.py",
      "type": "python",
      "requires": [
        "ui_tk",
        "session_log"
      ]
    },
    {
      "id": "ui_library",
      "name": "UI Library",
      "file": "ui_library.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "ui_modules",
      "name": "UI Modules Manager",
      "file": "ui_modules.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "ui_notes",
      "name": "UI Notes",
      "file": "ui_notes.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "ui_zoom",
      "name": "UI Zoom Controls",
      "file": "ui_zoom.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "integrations",
      "name": "Integrations Backend",
      "file": "integrations.py",
      "type": "python"
    },
    {
      "id": "server_sync",
      "name": "Server Synchronization",
      "file": "server_sync.py",
      "type": "python"
    },
    {
      "id": "ui_class",
      "name": "Class Guide",
      "file": "ui_class.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "ui_compare",
      "name": "Account Comparison",
      "file": "ui_compare.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "ui_detect",
      "name": "Player Detection",
      "file": "ui_detect.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "ui_integrations",
      "name": "Integrations Interface",
      "file": "ui_integrations.py",
      "type": "python",
      "requires": [
        "integrations",
        "ui_tk"
      ]
    },
    {
      "id": "ui_keys",
      "name": "Keyboard Statistics",
      "file": "ui_keys.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "ui_resources",
      "name": "Resource Monitor",
      "file": "ui_resources.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "ui_screen",
      "name": "Screen Interface",
      "file": "ui_screen.py",
      "type": "python",
      "requires": [
        "ui_tk"
      ]
    },
    {
      "id": "ui_server",
      "name": "Server Interface",
      "file": "ui_server.py",
      "type": "python",
      "requires": [
        "server_sync",
        "ui_tk"
      ]
    },
    {
      "id": "similarity_calibration",
      "name": "Similarity Calibration",
      "file": "similarity_calibration.py",
      "type": "python"
    },
    {
      "id": "ui_calibration",
      "name": "Similarity Calibration Interface",
      "file": "ui_calibration.py",
      "type": "python",
      "requires": [
        "similarity_calibration",
        "ui_tk"
      ]
    },
    {
      "id": "ui_tk",
      "name": "Shared Tkinter UI",
      "file": "ui_tk.py",
      "type": "python"
    }
  ]
}
